{% extends 'base.html.twig' %}

{% block title %}{{ vehicle.brand }} {{ vehicle.model }} — Garage{% endblock %}

{% block body %}
    {% set cardTone = vehicle.type|lower == 'moto' ? 'bg-info text-info-foreground' : 'bg-brand text-brand-foreground' %}

    <div class="min-h-screen" data-controller="modal" data-modal-open-value="{{ open_invoice_modal|default(false) ? 'true' : 'false' }}" data-action="keydown.esc@window->modal#closeOnEscape">
        {# Barre de navigation supérieure #}
        <header class="mx-auto flex max-w-7xl items-center justify-between px-4 py-6 sm:px-6">
            <a href="{{ path('app_dashboard') }}" class="flex items-center gap-2 rounded-full bg-card px-4 py-2.5 text-sm font-semibold shadow-sm transition hover:bg-secondary">
                {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }}
                Retour au garage
            </a>

            <div class="flex items-center gap-2">
                <button type="button" class="grid size-11 cursor-pointer place-items-center rounded-full bg-card shadow-sm transition hover:bg-secondary" aria-label="Modifier le véhicule">
                    {{ ux_icon('lucide:pencil', {class: 'size-4'}) }}
                </button>
            </div>
        </header>

        <main class="mx-auto max-w-7xl space-y-8 px-4 pb-16 sm:px-6">
            {# Bannière principale du véhicule #}
            <section class="relative overflow-hidden rounded-3xl p-6 sm:p-10 {{ cardTone }} animate-rise">
                <div class="relative z-10 flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
                    <div class="space-y-3">
                        <span class="inline-block rounded-full bg-card/90 px-3.5 py-1 font-mono text-sm font-bold text-foreground">
                            {{ vehicle.plate }}
                        </span>
                        <h1 class="font-display text-4xl font-bold sm:text-5xl">
                            {{ vehicle.brand }} {{ vehicle.model }}
                        </h1>
                        <p class="text-sm opacity-85">
                            {% if vehicle.firstRegistrationDate %}
                                1ère mise en circulation : {{ vehicle.firstRegistrationDate|date('d/m/Y') }}
                            {% else %}
                                Date de mise en circulation non renseignée
                            {% endif %}
                        </p>
                    </div>

                    <div class="flex flex-wrap gap-3">
                        <button type="button" data-action="modal#open" data-modal-id-param="modal-invoice" class="flex h-12 cursor-pointer items-center gap-2 rounded-full bg-card px-6 font-semibold text-foreground shadow-sm transition hover:-translate-y-0.5">
                            {{ ux_icon('lucide:plus', {class: 'size-5'}) }}
                            Ajouter une facture
                        </button>
                    </div>
                </div>

                {% if vehicle.type|lower == 'moto' %}
                    {{ ux_icon('mdi:motorbike', {class: 'pointer-events-none absolute -bottom-6 right-4 size-48 opacity-20 sm:size-64'}) }}
                {% else %}
                    {{ ux_icon('lucide:car', {class: 'pointer-events-none absolute -bottom-8 right-2 size-52 opacity-20 sm:size-72', 'stroke-width': '1.2'}) }}
                {% endif %}
            </section>

            {# Statistiques du véhicule #}
            <section class="grid gap-4 sm:grid-cols-3">
                <twig:StatCard
                    label="Dernier kilométrage"
                    value="{{ current_mileage|number_format(0, ',', ' ') }} km"
                    icon="lucide:gauge"
                />
                <twig:StatCard
                    label="Total dépenses TTC"
                    value="{{ total_spent|number_format(2, ',', ' ') }} €"
                    icon="lucide:euro"
                />
                <twig:StatCard
                    label="Factures enregistrées"
                    value="{{ vehicle.invoices|length }}"
                    icon="lucide:wrench"
                />
            </section>

            {# Grille principale : Historique d'entretien (2/3) + Assurance (1/3) #}
            <div class="grid gap-6 lg:grid-cols-3">
                {# Colonne gauche : Factures et entretiens #}
                <section class="space-y-4 lg:col-span-2">
                    <div class="flex items-center justify-between">
                        <h2 class="font-display text-2xl font-bold">Historique & Factures</h2>
                    </div>

                    {% if vehicle.invoices is empty %}
                        <div class="flex flex-col items-center justify-center rounded-3xl border-2 border-dashed border-border bg-card/50 p-10 text-center">
                            <span class="mb-3 grid size-12 place-items-center rounded-2xl bg-secondary text-muted-foreground">
                                {{ ux_icon('lucide:wrench', {class: 'size-6'}) }}
                            </span>
                            <p class="font-semibold">Aucune facture enregistrée</p>
                            <p class="mt-1 max-w-sm text-sm text-muted-foreground">
                                Ajoute tes factures de garage, révisions ou achats de pièces pour suivre l'entretien et le kilométrage.
                            </p>
                        </div>
                    {% else %}
                        <div class="space-y-3">
                            {% for invoice in vehicle.invoices %}
                                <div class="flex flex-col justify-between gap-4 rounded-2xl bg-card p-5 shadow-sm sm:flex-row sm:items-center">
                                    <div class="flex items-center gap-4">
                                        <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-secondary text-foreground">
                                            {{ ux_icon('lucide:file-text', {class: 'size-5'}) }}
                                        </span>
                                        <div>
                                            <p class="font-semibold">
                                                {{ invoice.garage ?: invoice.invoiceOriginalName }}
                                            </p>
                                            <p class="text-xs text-muted-foreground">
                                                Le {{ invoice.invoiceDate|date('d/m/Y') }}
                                                {% if invoice.mileage %}
                                                    • {{ invoice.mileage|number_format(0, ',', ' ') }} km
                                                {% endif %}
                                            </p>
                                        </div>
                                    </div>

                                    <div class="flex items-center justify-between gap-4 sm:justify-end">
                                        {% if invoice.totalTTC is not null %}
                                            <span class="font-display text-lg font-bold">
                                                {{ invoice.totalTTC|number_format(2, ',', ' ') }} €
                                            </span>
                                        {% endif %}

                                        <button
                                            type="button"
                                            data-action="modal#open"
                                            data-modal-id-param="modal-viewer"
                                            data-url="{{ asset('uploads/invoices/' ~ invoice.invoicePath) }}"
                                            data-title="{{ (invoice.garage ?: invoice.invoiceOriginalName) ~ ' — ' ~ invoice.invoiceDate|date('d/m/Y') }}"
                                            class="grid size-10 cursor-pointer place-items-center rounded-xl bg-secondary text-foreground transition hover:bg-border"
                                            title="Visualiser le document"
                                        >
                                            {{ ux_icon('lucide:eye', {class: 'size-4'}) }}
                                        </button>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>

                {# Colonne droite : Contrats d'assurance (Covered) #}
                <section class="space-y-4">
                    <div class="flex items-center justify-between">
                        <h2 class="font-display text-2xl font-bold">Assurance</h2>
                        <button type="button" data-action="modal#open" data-modal-id-param="modal-insurance" class="cursor-pointer text-sm font-semibold text-brand hover:underline">
                            + Associer
                        </button>
                    </div>

                    {% if vehicle.coverages is empty %}
                        <div class="rounded-3xl bg-card p-6 shadow-sm">
                            <div class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted-foreground">
                                {{ ux_icon('lucide:shield-check', {class: 'size-4'}) }}
                                Couverture
                            </div>
                            <p class="text-sm text-muted-foreground">Aucun contrat d'assurance associé à ce véhicule.</p>
                        </div>
                    {% else %}
                        {% for coverage in vehicle.coverages %}
                            {% set ins = coverage.insurance %}
                            <div class="space-y-4 rounded-3xl bg-card p-6 shadow-sm">
                                <div class="flex items-center justify-between">
                                    <span class="font-mono text-xs font-bold uppercase tracking-widest text-brand">Assuré</span>
                                    <button
                                        type="button"
                                        data-action="modal#open"
                                        data-modal-id-param="modal-viewer"
                                        data-url="{{ asset('uploads/insurances/' ~ ins.insurancePath) }}"
                                        data-title="Assurance {{ ins.insurer }} — Contrat {{ ins.contractNumber }}"
                                        class="grid size-9 cursor-pointer place-items-center rounded-xl bg-secondary text-foreground transition hover:bg-border"
                                        title="Visualiser l'attestation"
                                    >
                                        {{ ux_icon('lucide:eye', {class: 'size-4'}) }}
                                    </button>
                                </div>

                                <div>
                                    <p class="font-display text-xl font-bold">{{ ins.insurer }}</p>
                                    <p class="font-mono text-xs text-muted-foreground">N° {{ ins.contractNumber }}</p>
                                </div>

                                <div class="grid grid-cols-2 gap-2 rounded-2xl bg-muted p-3 text-xs">
                                    <div>
                                        <span class="block text-muted-foreground">Échéance</span>
                                        <span class="font-semibold">{{ ins.endDate|date('d/m/Y') }}</span>
                                    </div>
                                    <div>
                                        <span class="block text-muted-foreground">Cotisation</span>
                                        <span class="font-semibold">{{ coverage.premium|number_format(2, ',', ' ') }} €</span>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </section>

            </div>
        </main>

        {# Fenêtre modale d'ajout de facture #}
        <div
            id="modal-invoice"
            data-modal-target="dialog"
            data-action="click->modal#closeOnBackdrop"
            class="fixed inset-0 z-50 hidden items-center justify-center bg-primary/40 p-4 backdrop-blur-md transition"
        >
            <div class="relative max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-3xl bg-background p-6 shadow-2xl sm:p-8 animate-rise">
                <div class="mb-6 flex items-center justify-between">
                    <div>
                        <h2 class="font-display text-2xl font-bold sm:text-3xl">Nouvelle facture</h2>
                        <p class="text-sm text-muted-foreground">Enregistre un entretien ou une dépense pour ce véhicule.</p>
                    </div>
                    <button
                        type="button"
                        data-action="modal#close"
                        class="grid size-10 cursor-pointer place-items-center rounded-full bg-secondary text-foreground transition hover:bg-border"
                        aria-label="Fermer"
                    >
                        {{ ux_icon('lucide:x', {class: 'size-5'}) }}
                    </button>
                </div>

                {{ form_start(invoice_form, {
    attr: {
        'data-controller': 'invoice-scan',
        'data-invoice-scan-url-value': path('app_invoice_analyze')
    }
}) }}
                {# Le champ fichier garde data-invoice-scan-target="fileInput" #}
                {{ form_row(invoice_form.invoiceFile, {
        attr: {
            'data-invoice-scan-target': 'fileInput',
            'data-action': 'change->invoice-scan#scan'
        }
    }) }}

                <p data-invoice-scan-target="status" class="mb-4 hidden rounded-xl bg-brand/10 px-3.5 py-2.5 text-xs font-semibold text-brand"></p>

                {# Les 4 champs ci-dessous utilisent maintenant data-scan-field="..." #}
                {{ form_row(invoice_form.invoiceDate, {attr: {'data-scan-field': 'date'}}) }}
                {{ form_row(invoice_form.garage, {attr: {'data-scan-field': 'garage'}}) }}

                <div class="grid gap-4 sm:grid-cols-2">
                    {{ form_row(invoice_form.mileage, {attr: {'data-scan-field': 'mileage'}}) }}
                    {{ form_row(invoice_form.totalTTC, {attr: {'data-scan-field': 'totalTTC'}}) }}
                </div>

                <div class="mt-6 flex items-center justify-end gap-3 pt-2">
                    <button
                        type="button"
                        data-action="modal#close"
                        class="h-12 cursor-pointer rounded-xl px-5 font-semibold text-muted-foreground transition hover:bg-secondary hover:text-foreground"
                    >
                        Annuler
                    </button>
                    <button
                        type="submit"
                        class="flex h-12 cursor-pointer items-center gap-2 rounded-xl bg-primary px-6 font-semibold text-primary-foreground transition hover:-translate-y-0.5"
                    >
                        {{ ux_icon('lucide:plus', {class: 'size-4'}) }}
                        Enregistrer
                    </button>
                </div>
                {{ form_end(invoice_form) }}


            </div>
        </div>

        {# Fenêtre modale d'ajout d'assurance #}
        <div
            id="modal-insurance"
            data-modal-target="dialog"
            data-action="click->modal#closeOnBackdrop"
            class="fixed inset-0 z-50 hidden items-center justify-center bg-primary/40 p-4 backdrop-blur-md transition"
        >
            <div class="relative max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-3xl bg-background p-6 shadow-2xl sm:p-8 animate-rise">
                <div class="mb-6 flex items-center justify-between">
                    <div>
                        <h2 class="font-display text-2xl font-bold sm:text-3xl">Associer une assurance</h2>
                        <p class="text-sm text-muted-foreground">Téléverse ton attestation pour pré-remplir le contrat.</p>
                    </div>
                    <button
                        type="button"
                        data-action="modal#close"
                        class="grid size-10 cursor-pointer place-items-center rounded-full bg-secondary text-foreground transition hover:bg-border"
                        aria-label="Fermer"
                    >
                        {{ ux_icon('lucide:x', {class: 'size-5'}) }}
                    </button>
                </div>

                {{ form_start(insurance_form, {
                attr: {
                    'data-controller': 'invoice-scan',
                    'data-invoice-scan-url-value': path('app_insurance_analyze', {
                        plate: vehicle.plate,
                        vehicle: vehicle.brand ~ ' ' ~ vehicle.model ~ ' (' ~ vehicle.type ~ ')'
                        })
                }
            }) }}
                {{ form_row(insurance_form.insuranceFile, {
                    attr: {
                        'data-invoice-scan-target': 'fileInput',
                        'data-action': 'change->invoice-scan#scan'
                    }
                }) }}

                <p data-invoice-scan-target="status" class="mb-4 hidden rounded-xl bg-brand/10 px-3.5 py-2.5 text-xs font-semibold text-brand"></p>

                <div class="grid gap-4 sm:grid-cols-2">
                    {{ form_row(insurance_form.insurer, {attr: {'data-scan-field': 'insurer'}}) }}
                    {{ form_row(insurance_form.contractNumber, {attr: {'data-scan-field': 'contractNumber'}}) }}
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    {{ form_row(insurance_form.startDate, {attr: {'data-scan-field': 'startDate'}}) }}
                    {{ form_row(insurance_form.endDate, {attr: {'data-scan-field': 'endDate'}}) }}
                </div>

                {{ form_row(insurance_form.premium, {attr: {'data-scan-field': 'premium'}}) }}

                <div class="mt-6 flex items-center justify-end gap-3 pt-2">
                    <button
                        type="button"
                        data-action="modal#close"
                        class="h-12 cursor-pointer rounded-xl px-5 font-semibold text-muted-foreground transition hover:bg-secondary hover:text-foreground"
                    >
                        Annuler
                    </button>
                    <button
                        type="submit"
                        class="flex h-12 cursor-pointer items-center gap-2 rounded-xl bg-primary px-6 font-semibold text-primary-foreground transition hover:-translate-y-0.5"
                    >
                        {{ ux_icon('lucide:plus', {class: 'size-4'}) }}
                        Enregistrer
                    </button>
                </div>
                {{ form_end(insurance_form) }}
            </div>
        </div>


        {# Fenêtre modale d'aperçu de document (PDF ou Image) #}
        <div
            id="modal-viewer"
            data-modal-target="dialog"
            data-action="click->modal#closeOnBackdrop"
            class="fixed inset-0 z-50 hidden items-center justify-center bg-primary/40 p-4 backdrop-blur-md transition"
        >
            <div class="relative flex h-[88vh] w-full max-w-4xl flex-col overflow-hidden rounded-3xl bg-background shadow-2xl animate-rise">
                <div class="flex items-center justify-between border-b border-border px-6 py-4">
                    <h3 data-modal-target="docTitle" class="truncate pr-4 font-display text-lg font-bold sm:text-xl">
                        Aperçu du document
                    </h3>

                    <div class="flex items-center gap-2">
                        <a
                            data-modal-target="docDownload"
                            href="#"
                            download
                            class="grid size-10 place-items-center rounded-full bg-secondary text-foreground transition hover:bg-border"
                            title="Télécharger le fichier"
                        >
                            {{ ux_icon('lucide:download', {class: 'size-4'}) }}
                        </a>
                        <button
                            type="button"
                            data-action="modal#close"
                            class="grid size-10 cursor-pointer place-items-center rounded-full bg-secondary text-foreground transition hover:bg-border"
                            aria-label="Fermer"
                        >
                            {{ ux_icon('lucide:x', {class: 'size-5'}) }}
                        </button>
                    </div>
                </div>

                <div class="flex flex-1 items-center justify-center overflow-auto bg-muted/50 p-4">
                    <img
                        data-modal-target="docImage"
                        src=""
                        alt="Facture"
                        class="hidden max-h-full max-w-full rounded-xl object-contain shadow-sm"
                    >
                    <iframe
                        data-modal-target="docPdf"
                        src=""
                        class="hidden h-full w-full rounded-xl border-0 bg-white"
                        title="Aperçu PDF"
                    ></iframe>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
