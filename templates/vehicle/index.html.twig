{% extends 'base.html.twig' %}

{% set isEdit = vehicle is defined and vehicle.id is not null %}

{% block title %}{{ isEdit ? 'Modifier ' ~ vehicle.brand ~ ' ' ~ vehicle.model : 'Nouveau véhicule' }} — Garage{% endblock %}

{% block body %}
    <div class="min-h-screen bg-background">
        {# Barre de navigation supérieure #}
        <header class="mx-auto flex max-w-3xl items-center justify-between px-4 py-6 sm:px-6">
            <a
                href="{{ isEdit ? path('app_vehicle_show', {id : vehicle.id}) : path('app_dashboard') }}"
                class="flex items-center gap-2 rounded-full bg-card px-4 py-2.5 text-sm font-semibold shadow-sm transition hover:bg-secondary"
            >
                {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }}
                {{ isEdit ? 'Retour à la fiche' : 'Retour au garage' }}
            </a>
        </header>

        <main class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
            <div class="rounded-3xl bg-card p-6 shadow-sm sm:p-10 animate-rise">
                <div class="mb-8 flex items-center gap-4">
                    <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-brand/10 text-brand">
                        {% if isEdit and vehicle.type|lower == 'moto' %}
                            {{ ux_icon('mdi:motorbike', {class: 'size-7'}) }}
                        {% else %}
                            {{ ux_icon('lucide:car', {class: 'size-7'}) }}
                        {% endif %}
                    </span>
                    <div>
                        <h1 class="font-display text-3xl font-bold sm:text-4xl">
                            {{ isEdit ? 'Modifier le véhicule' : 'Ajouter un véhicule' }}
                        </h1>
                        <p class="mt-1 text-sm text-muted-foreground">
                            {{ isEdit
                                ? 'Mets à jour les informations ou ajuste la préconisation constructeur.'
                                : 'Renseigne ton véhicule : l’IA déterminera automatiquement son intervalle de révision.' }}
                        </p>
                    </div>
                </div>

                {{ form_start(form, {attr: {class: 'space-y-6', 'data-controller': 'brand-autocomplete'}}) }}
                    {# Type et Carburant #}
                    <div class="grid gap-4 sm:grid-cols-2">
                        {{ form_row(form.type) }}
                        {% if form.fuelType is defined %}
                            {{ form_row(form.fuelType) }}
                        {% endif %}
                    </div>

                    {# Marque et Modèle #}
                    <div class="grid gap-4 sm:grid-cols-2">
                        {{ form_row(form.brand) }}
                        {{ form_row(form.model) }}
                    </div>

                    {# Plaque et Date de 1ère mise en circulation #}
                    <div class="grid gap-4 sm:grid-cols-2">
                        {{ form_row(form.plate) }}
                        {{ form_row(form.firstRegistrationDate) }}
                    </div>

                    {# Encart Préconisation constructeur (IA ou personnalisé) #}
                    {% if form.serviceIntervalKm is defined and form.serviceIntervalMonths is defined %}
                        <div class="rounded-2xl border border-border bg-muted/40 p-5">
                            <div class="mb-3 flex items-center gap-2">
                                <span class="grid size-8 place-items-center rounded-xl bg-brand/10 text-brand">
                                    {{ ux_icon('lucide:sparkles', {class: 'size-4'}) }}
                                </span>
                                <div>
                                    <h2 class="text-sm font-bold">Préconisation constructeur (Révisions)</h2>
                                    <p class="text-xs text-muted-foreground">
                                        Laisse ces champs vides pour laisser l’IA Gemini déduire l’intervalle constructeur.
                                    </p>
                                </div>
                            </div>

                            <div class="grid gap-4 sm:grid-cols-2">
                                {{ form_row(form.serviceIntervalKm) }}
                                {{ form_row(form.serviceIntervalMonths) }}
                            </div>
                        </div>
                    {% endif %}

                    <datalist id="vehicle-brands-list" data-brand-autocomplete-target="datalist"></datalist>

                    {# Boutons d'action #}
                    <div class="flex flex-col-reverse gap-3 border-t border-border pt-6 sm:flex-row sm:justify-end">
                        <a
                            href="{{ isEdit ? path('app_vehicle_show', {id : vehicle.id}) : path('app_dashboard') }}"
                            class="flex h-12 items-center justify-center rounded-xl px-6 font-semibold text-muted-foreground transition hover:bg-secondary hover:text-foreground"
                        >
                            Annuler
                        </a>
                        <button
                            type="submit"
                            class="flex h-12 cursor-pointer items-center justify-center gap-2 rounded-xl bg-primary px-8 font-semibold text-primary-foreground shadow-sm transition hover:-translate-y-0.5"
                        >
                            {{ ux_icon('lucide:check', {class: 'size-4'}) }}
                            {{ isEdit ? 'Enregistrer les modifications' : 'Ajouter au garage' }}
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </main>
    </div>
{% endblock %}
