{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — Garage{% endblock %}

{% block body %}
    <div class="flex min-h-screen flex-col justify-center bg-background px-4 py-12 sm:px-6">
        <div class="mx-auto w-full max-w-md animate-rise">
            <div class="mb-6">
                <a href="{{ path('app_login') }}" class="inline-flex items-center gap-2 rounded-full bg-card px-4 py-2 text-sm font-semibold shadow-sm transition hover:bg-secondary">
                    {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }}
                    Retour à la connexion
                </a>
            </div>

            <div class="rounded-3xl bg-card p-8 shadow-sm sm:p-10">
                <div class="mb-6 flex items-center gap-4">
                    <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-brand/10 text-brand">
                        {{ ux_icon('lucide:key-round', {class: 'size-6'}) }}
                    </span>
                    <div>
                        <h1 class="font-display text-2xl font-bold">Mot de passe oublié</h1>
                        <p class="text-xs text-muted-foreground">Récupération de ton accès</p>
                    </div>
                </div>

                {% for flash_error in app.flashes('reset_password_error') %}
                    <div class="mb-5 rounded-2xl bg-alert/10 p-4 text-sm font-medium text-alert" role="alert">
                        {{ flash_error }}
                    </div>
                {% endfor %}

                <p class="mb-6 text-sm leading-relaxed text-muted-foreground">
                    Saisis l'adresse email associée à ton compte. Nous t'enverrons immédiatement un lien sécurisé pour définir un nouveau mot de passe.
                </p>

                {{ form_start(requestForm, {attr: {class: 'space-y-5'}}) }}
                    {{ form_row(requestForm.email, {
                        label: 'Adresse email',
                        attr: {placeholder: 'exemple@domaine.fr'}
                    }) }}

                    <button type="submit" class="flex h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-primary px-6 font-semibold text-primary-foreground shadow-sm transition hover:-translate-y-0.5">
                        {{ ux_icon('lucide:send', {class: 'size-4'}) }}
                        Envoyer le lien de réinitialisation
                    </button>
                {{ form_end(requestForm) }}
            </div>
        </div>
    </div>
{% endblock %}
