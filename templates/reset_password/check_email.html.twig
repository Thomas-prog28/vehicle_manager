{% extends 'base.html.twig' %}

{% block title %}Email envoyé — Garage{% endblock %}

{% block body %}
    <div class="flex min-h-screen flex-col justify-center bg-background px-4 py-12 sm:px-6">
        <div class="mx-auto w-full max-w-md animate-rise">
            <div class="rounded-3xl bg-card p-8 text-center shadow-sm sm:p-10">
                <span class="mx-auto mb-5 grid size-14 place-items-center rounded-2xl bg-brand/10 text-brand">
                    {{ ux_icon('lucide:mail-check', {class: 'size-7'}) }}
                </span>

                <h1 class="font-display text-2xl font-bold">Vérifie ta boîte mail</h1>

                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                    Si un compte correspond à cette adresse email, un lien de réinitialisation vient d'être envoyé.
                    Ce lien expirera dans
                    <strong class="text-foreground">{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
                </p>

                <div class="mt-6 rounded-2xl bg-muted/50 p-4 text-xs text-muted-foreground">
                    Tu n'as rien reçu ? Pense à vérifier ton dossier <strong>Courriers indésirables (Spams)</strong> ou
                    <a href="{{ path('app_forgot_password_request') }}" class="font-semibold text-foreground underline hover:text-brand">
                        réessaie avec une autre adresse
                    </a>.
                </div>

                <div class="mt-8">
                    <a href="{{ path('app_login') }}" class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-secondary px-6 text-sm font-semibold text-foreground transition hover:bg-border">
                        {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }}
                        Retour à la connexion
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
