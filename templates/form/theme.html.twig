{% use "tailwind_2_layout.html.twig" %}

{# Conteneur de chaque ligne de formulaire (label + input + erreur) #}
{% block form_row %}
    <div class="space-y-2 mb-5">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
        {{ form_help(form) }}
    </div>
{% endblock %}

{# Style des labels (identique à la page de connexion) #}
{% block form_label %}
    {% if label is not same as(false) %}
        {% set label_attr = label_attr|merge({
            class: (label_attr.class|default('') ~ ' block font-mono text-[11px] uppercase tracking-[0.12em] text-muted-foreground')|trim
        }) %}
        <label{% with { attr: label_attr } %}{{ block('attributes') }}{% endwith %}>
            {{- label is empty ? name|humanize : label|trans({}, translation_domain) -}}
            {%- if required %} <span class="text-alert">*</span>{% endif -%}
        </label>
    {% endif %}
{% endblock %}

{# Style commun des champs texte, email, nombre, date #}
{% block form_widget_simple %}
    {% set type = type|default('text') %}
    {% if type not in ['hidden', 'range', 'file'] %}
        {% set attr = attr|merge({
            class: (attr.class|default('') ~ ' h-12 w-full rounded-xl border border-input bg-card px-4 text-sm text-foreground outline-none transition focus:border-brand focus:ring-2 focus:ring-ring/30')|trim
        }) %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{# Style des listes déroulantes (select : Voiture / Moto) #}
{% block choice_widget_collapsed %}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ ' h-12 w-full cursor-pointer rounded-xl border border-input bg-card px-4 text-sm text-foreground outline-none transition focus:border-brand focus:ring-2 focus:ring-ring/30')|trim
    }) %}
    {{ parent() }}
{% endblock %}

{# Style des zones de texte (textarea) #}
{% block textarea_widget %}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ ' w-full rounded-xl border border-input bg-card p-4 text-sm text-foreground outline-none transition focus:border-brand focus:ring-2 focus:ring-ring/30')|trim
    }) %}
    {{ parent() }}
{% endblock %}

{# Style des cases à cocher (checkbox) #}
{% block checkbox_widget %}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ ' size-4 cursor-pointer rounded border-input text-brand focus:ring-ring')|trim
    }) %}
    {{ parent() }}
{% endblock %}

{# Style des erreurs de validation (ex: plaque invalide ou déjà existante) #}
{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="space-y-1 text-xs font-semibold text-alert">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
