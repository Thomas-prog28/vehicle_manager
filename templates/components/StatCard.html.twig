{% props label, value, icon, hot = false %}

<div class="flex items-center justify-between rounded-3xl p-6 {{ hot ? 'bg-primary text-primary-foreground' : 'bg-card shadow-sm' }}">
    <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] {{ hot ? 'text-primary-foreground/90' : 'text-muted-foreground' }}">
            {{ label }}
        </p>
        <p class="font-display text-3xl font-bold">{{ value }}</p>
    </div>
    <span class="grid size-12 place-items-center rounded-2xl {{ hot ? 'bg-brand text-brand-foreground' : 'bg-secondary' }}">
        {{ ux_icon(icon, {class: 'size-5'}) }}
    </span>
</div>
