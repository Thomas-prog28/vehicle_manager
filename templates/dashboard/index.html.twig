{% extends 'base.html.twig' %}

{% block title %}Mes véhicules{% endblock %}

{% block body %}
<section>
    <div class="container">
        <h1>Mes véhicules</h1>
        <a href="{{ path('app_vehicle_new') }}">Ajouter un véhicule</a>

        {% for vehicle in vehicles %}
            <article>
                <h2>{{ vehicle.brand }} {{ vehicle.model }}</h2>
                <p>{{ vehicle.plate }} · {{ vehicle.type == 'car' ? 'Voiture' : 'Moto' }}</p>
            </article>
        {% else %}
            <p>Aucun véhicule pour le moment.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}