{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Tableau de bord & Statistiques{% endblock %}

{% block main %}
    {# Cartes KPI globales #}
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted text-uppercase small fw-bold mb-1">Utilisateurs inscrits</div>
                    <div class="fs-2 fw-bold">{{ total_users }}</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted text-uppercase small fw-bold mb-1">Connexions cumulées</div>
                    <div class="fs-2 fw-bold text-primary">{{ total_logins }}</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted text-uppercase small fw-bold mb-1">Fichiers téléversés</div>
                    <div class="fs-2 fw-bold text-success">{{ total_files }}</div>
                    <div class="small text-muted">{{ total_invoices }} factures • {{ total_insurances }} assurances</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted text-uppercase small fw-bold mb-1">Véhicules & Pleins</div>
                    <div class="fs-2 fw-bold">{{ total_vehicles }} <span class="fs-6 fw-normal text-muted">véhicules</span></div>
                    <div class="small text-muted">{{ total_fuel_logs }} pleins enregistrés</div>
                </div>
            </div>
        </div>
    </div>

    {# Tableau synthétique d'activité par utilisateur #}
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold">Activité des utilisateurs</h5>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController') }}" class="btn btn-sm btn-primary">
                Gérer les comptes
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Utilisateur</th>
                        <th>Rôle</th>
                        <th class="text-center">Connexions</th>
                        <th>Dernière connexion</th>
                        <th class="text-center">Véhicules</th>
                        <th class="text-center">Fichiers téléversés</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                        <tr>
                            <td class="fw-semibold">{{ u.email }}</td>
                            <td>
                                {% if 'ROLE_ADMIN' in u.roles %}
                                    <span class="badge bg-danger">Admin</span>
                                {% else %}
                                    <span class="badge bg-secondary">Utilisateur</span>
                                {% endif %}
                            </td>
                            <td class="text-center fw-bold">{{ u.loginCount }}</td>
                            <td class="text-muted">
                                {{ u.lastLoginAt ? u.lastLoginAt|date('d/m/Y à H:i') : 'Jamais' }}
                            </td>
                            <td class="text-center">{{ u.vehicles|length }}</td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success-emphasis fs-6">
                                    {{ u.uploadedFilesCount }}
                                </span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Aucun utilisateur enregistré.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
